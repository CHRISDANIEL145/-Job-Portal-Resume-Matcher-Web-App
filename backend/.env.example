FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=jwt-change-me
DATABASE_URL=sqlite:///placement.db
# For Supabase / PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# OR (if using Supabase connection pooler):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
